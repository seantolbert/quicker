# Vercel AI Gateway key: https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai%2Fapi-keys
AI_GATEWAY_API_KEY=

# Optional: call Anthropic directly instead of the AI Gateway (used whenever this is set).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Places API (New) key, for building sites from a Google Business Profile link.
# Enable "Places API (New)" in Google Cloud. Reviews and photos are billed at the Enterprise + Atmosphere tier.
GOOGLE_PLACES_API_KEY=

# Optional: override the generation model (AI Gateway "provider/model" string)
# QUICKER_MODEL=anthropic/claude-sonnet-5.5

# Optional: where exported sites are written (default: ./exports)
# QUICKER_EXPORT_DIR=
